# CodePilotAI — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Every value below is a PLACEHOLDER.

# ─────────────────────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────
# Database — defaults to local SQLite. Point at Postgres in prod.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://codepilotai:PASSWORD@localhost:5432/codepilotai

# ─────────────────────────────────────────────────────────────
# Redis / Celery — required for background agent runs + SSE.
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ─────────────────────────────────────────────────────────────
# Groq LLM  <-- YOUR LLM PROVIDER
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=replace-me-gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=4

# ─────────────────────────────────────────────────────────────
# GitHub OAuth App  <-- YOUR GITHUB APP CREDENTIALS
# Create at: https://github.com/settings/developers -> OAuth Apps
#   Homepage URL:            http://localhost:8000
#   Authorization callback:  http://localhost:8000/api/v1/auth/github/callback
# Scopes: repo, read:user, user:email
# ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=replace-me-ov23xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=replace-me-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ─────────────────────────────────────────────────────────────
# Token encryption at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─────────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=replace-me-generated-fernet-key-base32

# ─────────────────────────────────────────────────────────────
# Android app
# ─────────────────────────────────────────────────────────────
ANDROID_DEEP_LINK_SCHEME=codepilotai
ANDROID_API_BASE_URL=http://10.0.2.2:8000/api/v1
CORS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────
# Git workspaces (per-task mirrors + worktrees)
# ─────────────────────────────────────────────────────────────
WORKSPACE_ROOT=./workspaces

# ─────────────────────────────────────────────────────────────
# Agent guardrails
# ─────────────────────────────────────────────────────────────
# Master switch for the Phase 4 approval-gated execution pipeline
# (apply -> verify -> repair -> commit -> push + PR behind Celery + SSE).
AGENT_PIPELINE_ENABLED=True
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_ITERATIONS=8
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_TOKEN_BUDGET=120000
AGENT_WALL_CLOCK_SECONDS=600
AGENT_DAILY_TOKEN_BUDGET=2000000

# ─────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (push notifications)  <-- YOUR FIREBASE PROJECT
# Create a Firebase project, add an Android app, download
# google-services.json into android/app/, and generate a service-account key
# (Project settings -> Service accounts -> Generate new private key).
# Leave these blank to disable push; the backend then sends nothing.
# ─────────────────────────────────────────────────────────────
FCM_ENABLED=True
FCM_PROJECT_ID=
# Paste the service-account JSON inline (single line), or point at the file.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# ─────────────────────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
